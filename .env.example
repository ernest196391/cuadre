# Copia este archivo a .env.local y rellena los valores.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO SERVIDOR. Sin prefijo NEXT_PUBLIC_ para que Next nunca las mande al navegador.
SUPABASE_SERVICE_ROLE_KEY=
# 32 bytes en base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAN_ENCRYPTION_KEY=
